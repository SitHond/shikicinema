{
    "manifest_version": 3,
    "name": "ShikiRIP Cinema",
    "version": "__processed-automatically__",
    "icons": {
        "64": "assets/icon64.png",
        "128": "assets/icon128.png"
    },
    "description": "Adds an inline video player to Shikimori (rip/fi/net/moe/mov). Browse your anime list, track episodes, switch between dubs and subs.",
    "content_security_policy": {
        "extension_pages": "default-src 'self'; img-src * data:; frame-src *; font-src *; media-src *; style-src 'unsafe-inline' https://*.googleapis.com; connect-src *; script-src 'self'"
    },
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*.png",
                "index.html",
                "permission-grant.html",
                "permission-grant.js"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    "permissions": [
        "storage",
        "tabs",
        "scripting",
        "notifications",
        "declarativeNetRequestWithHostAccess"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "mangalib_referer",
                "enabled": true,
                "path": "rules/mangalib_referer.json"
            },
            {
                "id": "remanga_referer",
                "enabled": true,
                "path": "rules/remanga_referer.json"
            },
            {
                "id": "readmanga_referer",
                "enabled": true,
                "path": "rules/readmanga_referer.json"
            },
            {
                "id": "kodik_referer",
                "enabled": true,
                "path": "rules/kodik_referer.json"
            },
            {
                "id": "rutube_referer",
                "enabled": true,
                "path": "rules/rutube_referer.json"
            }
        ]
    },
    "host_permissions": [
        "https://api.sithond.com/*",

        "https://*.cdnlibs.org/*",
        "https://plapi.cdnvideohub.com/*",
        "http://127.0.0.1/*",

        "https://api.mangadex.org/*",
        "https://uploads.mangadex.org/*",

        "https://api.remanga.org/*",
        "https://remanga.org/*",
        "https://img.remanga.org/*",

        "https://readmanga.live/*",
        "https://*.imgsmail.ru/*",
        "https://kodik.info/*",
        "https://kodik.biz/*",
        "https://kodik.cc/*",
        "https://rutube.ru/*",
        "https://*.rutube.ru/*",
        "https://api.aniskip.com/*",
        "https://cloud.solodcdn.com/*",
        "https://*.solodcdn.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*"
    ]
}
