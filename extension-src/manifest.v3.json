{
    "manifest_version": 3,
    "name": "ShikiRIP Cinema",
    "version": "__processed-automatically__",
    "icons": {
        "64": "assets/icon64.png",
        "128": "assets/icon128.png"
    },
    "description": "Adds an inline video player to Shikimori (rip/fi/net/moe). Browse your anime list, track episodes, switch between dubs and subs.",
    "content_security_policy": {
        "extension_pages": "default-src 'self'; img-src *; frame-src *; font-src *; media-src *; style-src 'unsafe-inline' https://*.googleapis.com; connect-src https://shikimori.rip https://shikimori.fi https://shikimori.net https://shikimori.moe https://ygg.shiki.rip https://api.sithond.com https://plapi.cdnvideohub.com ws://127.0.0.1:*; script-src 'self'"
    },
    "content_scripts": [
        {
            "matches": [
                "*://shikimori.rip/*",
                "*://shikimori.fi/*",
                "*://shikimori.net/*",
                "*://shikimori.moe/*",
                "*://ygg.shiki.rip/*"
            ],
            "js": [
                "shikicinema.js"
            ],
            "css": [
                "watch-button.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*.png",
                "index.html"
            ],
            "matches": [
                "*://shikimori.rip/*",
                "*://shikimori.fi/*",
                "*://shikimori.net/*",
                "*://shikimori.moe/*",
                "*://ygg.shiki.rip/*"
            ]
        }
    ],
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://shikimori.rip/*",
        "https://shikimori.fi/*",
        "https://shikimori.net/*",
        "https://shikimori.moe/*",
        "https://ygg.shiki.rip/*",
        "https://api.sithond.com/*",

        "https://remanga.org/*",
        "https://*.remanga.org/*",
        "https://plapi.cdnvideohub.com/*",
        "http://127.0.0.1/*"
    ]
}
