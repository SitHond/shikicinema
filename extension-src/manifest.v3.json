{
    "manifest_version": 3,
    "name": "ShikiRIP Cinema",
    "version": "__processed-automatically__",

    "icons": {
      "64": "assets/icon64.png",
      "128": "assets/icon128.png"
    },

    "description": "ShikiRIP Cinema fork: returns video player on Shikimori",
    "content_security_policy": {
      "extension_pages": "default-src 'self'; img-src *; frame-src *; font-src *; style-src 'unsafe-inline' https://*.googleapis.com; connect-src *; script-src 'self'"
    },

    "content_scripts": [
      {
        "matches": [
          "*://shikimori.rip/*",
          "*://shikimori.fi/*"
        ],
        "js": [
          "shikicinema.js"
        ],
        "css": [
          "watch-button.css"
        ],
        "run_at": "document_idle"
      }
    ],

    "background": {
      "service_worker": "background.js"
    },

    "web_accessible_resources": [
      {
        "resources": [
          "assets/*.png",
          "index.html",
          "styles.css",
          "*.js"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],

    "permissions": [
      "storage",
      "tabs",
      "unlimitedStorage"
    ],

    "host_permissions": [
      "https://shikimori.rip/*",
      "https://shikimori.fi/*",
      "https://api.sithond.com/*",
      "https://smarthard.net/*",
      "https://kodikapi.com/*",
      "https://remanga.org/*",
      "https://*.remanga.org/*",
      "https://smotret-anime.online/*"
    ]
  }
