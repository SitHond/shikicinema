{
    "manifest_version": 2,
    "name": "ShikiRIP Cinema",
    "version": "__processed-automatically__",
    "icons": {
        "64": "assets/icon64.png",
        "128": "assets/icon128.png"
    },
    "description": "Adds an inline video player to Shikimori (rip/fi/net/moe). Browse your anime list, track episodes, switch between dubs and subs.",
    "content_security_policy": "default-src 'self'; img-src *; frame-src *; font-src *; media-src *; style-src 'unsafe-inline' https://*.googleapis.com; connect-src *; script-src 'self'",
    "browser_specific_settings": {
        "gecko": {
            "id": "shikicinema@sithond.com",
            "strict_min_version": "109.0",
            "data_collection_permissions": {
                "required": ["none"],
                "optional": []
            }
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://shikimori.rip/*",
                "*://shikimori.fi/*",
                "*://shikimori.net/*",
                "*://shikimori.moe/*",
                "*://ygg.shiki.rip/*"
            ],
            "js": [
                "shikicinema.js"
            ],
            "css": [
                "watch-button.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": true
    },
    "web_accessible_resources": [
        "assets/*.png",
        "index.html",
        "styles.css",
        "*.js"
    ],
    "permissions": [
        "https://shikimori.rip/*",
        "https://shikimori.fi/*",
        "https://shikimori.net/*",
        "https://shikimori.moe/*",
        "https://ygg.shiki.rip/*",
        "https://api.sithond.com/*",

        "https://remanga.org/*",
        "https://*.remanga.org/*",
        "https://plapi.cdnvideohub.com/*",
        "http://127.0.0.1/*",
        "storage",
        "tabs"
    ]
}
