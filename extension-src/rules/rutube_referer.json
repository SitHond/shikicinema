[
    {
        "id": 1,
        "priority": 1,
        "action": {
            "type": "modifyHeaders",
            "requestHeaders": [
                {
                    "header": "Referer",
                    "operation": "set",
                    "value": "https://rutube.ru/"
                }
            ],
            "responseHeaders": [
                {
                    "header": "Access-Control-Allow-Origin",
                    "operation": "set",
                    "value": "*"
                },
                {
                    "header": "Access-Control-Allow-Methods",
                    "operation": "set",
                    "value": "GET, OPTIONS, HEAD"
                },
                {
                    "header": "Access-Control-Allow-Headers",
                    "operation": "set",
                    "value": "Range, Content-Type"
                }
            ]
        },
        "condition": {
            "urlFilter": "||rutube.ru/",
            "resourceTypes": ["xmlhttprequest", "media"]
        }
    }
]
